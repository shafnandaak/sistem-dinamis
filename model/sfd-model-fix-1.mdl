	~	ha/Year
	~		|

Luas Panen Padi=Luas Lahan Pertanian *K Luas Panen Padi
	~	ha/Year
	~		|

Penambahan Lahan Pertanian=IF THEN ELSE(
	    Laju Perubahan Lahan Pertanian > 0,
	    Luas Lahan Pertanian
	    * Laju Perubahan Lahan Pertanian,
	    0
	)
