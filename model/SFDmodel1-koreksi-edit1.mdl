	~	
	~		|

Subsidi Dasar=497391
	~	ton
	~		|

Luas Sawah Irigasi= INTEG (Penambahan Luas Sawah Irigasi,
		723636)
	~	ha
	~		|

Faktor Irigasi=1 + 0.2 * (Luas Sawah Irigasi / Luas Sawah Irigasi Dasar)
	~	satuan
	~		|

Efektivitas Irigasi=1 + 0.05 * ((Belanja Pemerintah Sektor Pertanian/ Belanja Dasar)-\
		1)
	~	satuan
	~		|

Belanja Pemerintah Sektor Pertanian=Belanja Dasar*(1+"% Penambahan RAB")
