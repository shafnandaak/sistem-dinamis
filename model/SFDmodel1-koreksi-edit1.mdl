		, (2023,0.6), (2024,0.6), (2025,0.6
		)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Kacang Hijau=(Jumlah Penduduk*Konsumsi Kacang Hijau Per Kapita)/1000
	~	ton/tahun
	~		|

Konsumsi Kacang Hijau Per Kapita = WITH LOOKUP (Time,
		([(2018,0.6)-(2025,94.3)],(2018,0.6), (2019,0.7), (2020,0.6), (2021,0.5), (2022,0.6\
		), (2023,0.5), (2024,0.5), (2025,0.5
		)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Kacang Tanah Per Kapita = WITH LOOKUP (Time,
		([(2018,0.2)-(2025,0.2)],(2018,0.2), (2019, 0.3), (2020,0.3), (2021,0.3), (2022,0.3\
		), (2023,0.2), (2024,0.2), (2025,0.2
		)))
	~	kg/(kapita/tahun)
	~		|

Konsumsi Kedelai=(Jumlah Penduduk*Konsumsi Kedelai Per Kapita)/1000
	~	ton/tahun
	~		|

Konsumsi Kedelai Per Kapita = WITH LOOKUP (Time,
		([(2018,10.5)-(2025,9.8)],(2018,10.5), (2019,10.4), (2020,10.1), (2021,10.7), (2022\
		,11.3), (2023,9.8), (2024,9.8), (2025
		,9.8)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Ubi Jalar Per Kapita = WITH LOOKUP (Time,
		([(2018,8.7)-(2025,94.3)],(2018,8.7), (2019,8.7), (2020,8.8), (2021,10.7), (2022,10\
		), (2023,10.3), (2024,10.3), (2025,
		10.3)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Ubi Kayu=(Konsumsi Ubi Kayu Per Kapita * Jumlah Penduduk)/ 1000
	~	ton/tahun
	~		|

Faktor Ekonomi Jagung=(Harga Produsen Jagung/Harga Dasar Jagung)*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Kacang Hijau=Harga Produsen Kacang Hijau/Harga Dasar Kacang Hijau*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Kacang Tanah=Harga Produsen Kacang Tanah/Harga dasar Kacang Tanah*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Ubi Kayu=(Harga Produsen Ubi Kayu/Harga Dasar Ubi Kayu)*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Harga Total=(Harga Produsen Jagung+Harga Produsen Kacang Hijau+Harga Produsen Kacang Tanah\
		+Harga Produsen Kedelai+Harga Produsen Padi GKG
	+Harga Produsen Ubi Jalar+Harga Produsen Ubi Kayu)/7
	~	rp
	~		|

Faktor Ekonomi Ubi Jalar=(Harga Produsen Ubi Jalar/ Harga Dasar Ubi Jalar) * Faktor Ekonomi Pertanian
	~	satuan
	~		|

PDRB Pertanian Tanaman Pangan=Nilai Produksi Jagung+Nilai Produksi Kacang Hijau+Nilai Produksi Kacang Tanah\
		+Nilai Produksi Kedelai+Nilai Produksi Padi
	+Nilai Produksi Ubi+Nilai Produksi Ubi Jalar
	~	rp
	~		|

Penambahan Luas Sawah Irigasi=Efektivitas Irigasi*Luas Sawah Irigasi Dasar*Persentase Perubahan Irigasi
	~	ha
	~		|

Konsumsi Ubi Kayu Per Kapita = WITH LOOKUP (Time,
		([(2018,0.3)-(2025,0.7)],(2018,8.7), (2019,8.7), (2020,8.8), (2021,10.7), (2022,10)\
		, (2023,10.3), (2024,10.3), (2025,10.3
		)))
	~	kg/kapita/Year
	~		|

Perubahan Luas Citra=IF THEN ELSE(
	Time = 2018,
	Estimasi Luas Citra - Luas Lahan Pertanian,
	Estimasi Luas Citra - DELAY1(Estimasi Luas Citra,1)
	)
	~	
	~		|

Luas Lahan Pertanian= INTEG (Laju Penambahan Lahan-Alih Fungsi Lahan,
		2.41616e+06)
	~	ha
	~		|

Alih Fungsi Lahan=MAX(0, -Perubahan Luas Citra)
	/ Efektivitas LP2B
	~	
	~		|

Subsidi Pupuk=IF THEN ELSE( Time < 2025 , 
	              Data Historis Subsidi Pupuk(Time) , 
	              Subsidi Dasar * (1 + "% Kenaikan Subsidi" * Efek RAB) )
	~	ton
	~		|

