	~		|

"Skor PPH Riil Umbi-umbian"="AKE Umbi-umbian"*"Bobot Umbi-umbian"
	~	
	~		|

Kalori Ideal=2400
	~	kkal/hari/kapita
	~		|

"Skor PPH Umbi-umbian"=IF THEN ELSE(
	    "Skor PPH Riil Umbi-umbian" > "Skor PPH Max Umbi-umbian",
	    "Skor PPH Max Umbi-umbian",
	    "Skor PPH Riil Umbi-umbian"
	)
	~	
	~		|

