Data Historis Laju Pertumbuhan Penduduk = WITH LOOKUP (Time,
		 ([(2018,1.49)-(2025,1.13)], (2018, 1.49),(2019,1.48),(2020,1.11),(2021,1.41),(2022\
		,1.33),(2023,1.18),(2024,1.13)))
	~	
	~		|

Laju Pertumbuhan Penduduk=IF THEN ELSE(Time < 2025, Data Historis Laju Pertumbuhan Penduduk\
		, Laju Proyeksi Penduduk)
	~	persen/tahun
	~		|

Laju Proyeksi Penduduk=1.3
	~	
	~		|

PDRB Per Kapita Pertanian Tanaman Pangan=PDRB Pertanian Tanaman Pangan/Jumlah Penduduk
	~	
	~		|

Laju Perubahan Pixel=(Pixel Akhir / Pixel Awal) ^ (1 / (Tahun Akhir - Tahun Awal)) - \
		1
	~	
	~		|

Pixel Awal= INITIAL(Data Historis Pixel)
	~	
	~		|

Estimasi Luas Citra=Jumlah Pixel*Luas Pixel
	~	ha
	~		|

Data Historis Pixel = WITH LOOKUP (Time,
		([(2018,393204)-(2024,411201)],(2018,393204), (2019,376294), (2020,389955), (2021,389041\
		), (2022,391818), (2023,389270
		), (2024,411201)))
	~	satuan
	~		|

Jumlah Pixel=IF THEN ELSE(
	    Time <= Tahun Akhir, 
	    Data Historis Pixel, 
	    Pixel Akhir * (1 + Laju Perubahan Pixel) ^ (Time - Tahun Akhir)
	)
	~	
	~		|

Pixel Akhir=SAMPLE IF TRUE(Time = Tahun Akhir, Data Historis Pixel, 0)
	~	
	~		|

Harga Total Dasar=(Harga Dasar Jagung+Harga Dasar Kacang Hijau+Harga dasar Kacang Tanah\
		+Harga Dasar Kedelai+Harga Dasar Padi GKG+Harga Dasar Ubi Jalar+Harga Dasar Ubi Kayu\
		)/7
	~	
	~		|

Kalori Kedelai=Konsumsi Kedelai*381*10000
	~	
	~		|

Data Historis NDVI = WITH LOOKUP (Time,
		( [(2018,0)-(2025,1)], (2018,0.630804),(2019,0.621201),(2020,0.627658),(2021,0.629935\
		),(2022,0.628543),(2023,0.631985),(2024,0.647878),(2025,0.66964) ))
	~	
	~		|

Indeks yang Dibayar Petani=IB Dasar * Tren Pengeluaran Makro * (Harga Total / Harga Total Dasar\
		) * (1 - (0.05 * (Efek Subsidi Pupuk - 1)))
	~	rp/ha
	~		|

Indeks yang Diterima Petani=IT Dasar * (Harga Total / Harga Total Dasar)*Faktor Kelangkaan
	~	satuan
	~		|

IT Dasar=100
	~	
	~		|

Tahun Awal=2018
	~	
	~		|

Faktor Kelangkaan=(Faktor Kelangkaan Beras+Faktor Kelangkaan Jagung+Faktor kelangkaan Kacang Hijau\
		+Faktor Kelangkaan Kacang Tanah+Faktor Kelangkaan Kedelai+Faktor Kelangkaan Ubi Jalar\
		+Faktor Kelangkaan Ubi Kayu)/7
	~	
	~		|

Tahun Akhir=2024
	~	
	~		|

Laju Pertumbuhan NDVI=(NDVI Akhir / NDVI Awal) ^ (1 / (Tahun Akhir - Tahun Awal)) - 1
	~	
	~		|

NDVI Awal= INITIAL(Data Historis NDVI)
	~	
	~		|

NDVI Akhir=SAMPLE IF TRUE(Time = Tahun Akhir, Data Historis NDVI, 0)
	~	
	~		|

NDVI=IF THEN ELSE(
	    Time <= Tahun Akhir, 
	    Data Historis NDVI, 
	    NDVI Akhir * (1 + Laju Pertumbuhan NDVI) ^ (Time - Tahun Akhir)
	)
	~	satuan
	~		|

Tren Pengeluaran Makro = WITH LOOKUP (Time,
		([(2018,1)-(2024,0.9786)],(2018,1), (2019,0.8509), (2020,0.8687), (2021,0.8864), (2022\
		,0.9161), (2023,0.9486), (2024,0.9786
		)))
	~	
	~		|

