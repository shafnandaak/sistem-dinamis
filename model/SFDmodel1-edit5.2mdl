	~	ha
	~		|

Konsumsi Ubi Kayu Per Kapita = WITH LOOKUP (Time,
		([(2018,0.3)-(2025,0.7)],(2018,8.7), (2019,8.7), (2020,8.8), (2021,10.7), (2022,10)\
		, (2023,10.3), (2024,10.3), (2025,10.3
		)))
