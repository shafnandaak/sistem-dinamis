Subsidi Dasar=497391
	~	ton
	~		|

Luas Sawah Irigasi= INTEG (Penambahan Luas Sawah Irigasi,
		723636)
	~	ha
	~		|

Faktor Irigasi=1 + 0.2 * (Luas Sawah Irigasi / Luas Sawah Irigasi Dasar)
	~	satuan
	~		|

Efektivitas Irigasi=1 + 0.05 * ((Belanja Pemerintah Sektor Pertanian/ Belanja Dasar)-\
		1)
	~	satuan
	~		|

Belanja Pemerintah Sektor Pertanian=Belanja Dasar*(1+"% Penambahan RAB")
	~	rp
	~		|

Harga Dasar Kacang Hijau=1.16455e+06
	~	rp/ku
	~		|

Harga dasar Kacang Tanah=1.00583e+06
	~	rp/ku
	~		|

Faktor Kelangkaan Kacang Tanah=1+0.05*(Penggunaan Kacang Tanah/Stok Kacang Tanah-1)
	~	satuan
	~		|

Harga Dasar Padi GKG=586234
	~	rp/kg
	~		|

Faktor Kelangkaan Beras=1+0.05*(Konsumsi Beras/Ketersediaan Beras-1)
	~	satuan
	~		|

Harga Produsen Kacang Tanah=SMOOTH ( Faktor Kelangkaan Kacang Tanah*Harga dasar Kacang Tanah\
		 , 1 )
	~	rp/ku
	~		|

Produksi Padi=(Produktivitas Padi*Luas Panen Padi)/10
	~	ton/tahun
	~		|

Harga Produsen Padi GKG=SMOOTH (Harga Dasar Padi GKG * Faktor Kelangkaan Beras,1)
	~	rp/kg
	~		|

Produksi Beras=Produksi Padi * 0.6274
	~	ton
	~		|

Harga Produsen Kacang Hijau=SMOOTH ( Faktor kelangkaan Kacang Hijau*Harga Dasar Kacang Hijau\
		 , 1 )
	~	rp/ku
	~		|

