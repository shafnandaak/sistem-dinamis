	~		|

"AKE Umbi-umbian"="Kontribusi Energi Umbi-umbian"/Kalori Ideal*100
	~	persen
	~		|

"Kontribusi Energi Umbi-umbian"=Ketersediaan Kalori Ubi Jalar
	~	
	~		|

BDD Ubi Jalar=85/100
	~	
	~		|

Kebutuhan Normatif Total=(Jumlah Penduduk * 300 * 365) / 1e+06
	~	
	~		|

Ubi Jalar Benih=Stok Ubi Jalar*K Benih Ubi Jalar
	~	
	~		|

"Bobot Umbi-umbian"=0.5
	~	
	~		|

"Skor PPH Riil Umbi-umbian"="AKE Umbi-umbian"*"Bobot Umbi-umbian"
	~	
	~		|

Kalori Ideal=2400
	~	kkal/hari/kapita
	~		|

"Skor PPH Umbi-umbian"=IF THEN ELSE(
	    "Skor PPH Riil Umbi-umbian" > "Skor PPH Max Umbi-umbian",
	    "Skor PPH Max Umbi-umbian",
	    "Skor PPH Riil Umbi-umbian"
	)
	~	
	~		|

"K Industri Non-Makanan Ubi Jalar"=0
	~	
	~		|

