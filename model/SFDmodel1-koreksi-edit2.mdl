Laju Perubahan Pixel=(Pixel Akhir / Pixel Awal) ^ (1 / (Tahun Akhir - Tahun Awal)) - \
		1
	~	
	~		|

Pixel Awal= INITIAL(Data Historis Pixel)
	~	
	~		|

Estimasi Luas Citra=Jumlah Pixel*Luas Pixel
	~	ha
	~		|

Data Historis Pixel = WITH LOOKUP (Time,
		([(2018,393204)-(2024,411201)],(2018,393204), (2019,376294), (2020,389955), (2021,389041\
		), (2022,391818), (2023,389270
		), (2024,411201)))
	~	satuan
	~		|

Jumlah Pixel=IF THEN ELSE(
	    Time <= Tahun Akhir, 
	    Data Historis Pixel, 
	    Pixel Akhir * (1 + Laju Perubahan Pixel) ^ (Time - Tahun Akhir)
	)
	~	
	~		|

Pixel Akhir=SAMPLE IF TRUE(Time = Tahun Akhir, Data Historis Pixel, 0)
	~	
	~		|

Harga Total Dasar=(Harga Dasar Jagung+Harga Dasar Kacang Hijau+Harga dasar Kacang Tanah\
		+Harga Dasar Kedelai+Harga Dasar Padi GKG+Harga Dasar Ubi Jalar+Harga Dasar Ubi Kayu\
		)/7
	~	
	~		|

Data Historis NDVI = WITH LOOKUP (Time,
		( [(2018,0)-(2025,1)], (2018,0.630804),(2019,0.621201),(2020,0.627658),(2021,0.629935\
		),(2022,0.628543),(2023,0.631985),(2024,0.647878),(2025,0.66964) ))
	~	
	~		|

Indeks yang Dibayar Petani=IB Dasar * Tren Pengeluaran Makro * (Harga Total / Harga Total Dasar\
		) * (1 - (0.05 * (Efek Subsidi Pupuk - 1)))
	~	rp/ha
	~		|

Indeks yang Diterima Petani=IT Dasar * (Harga Total / Harga Total Dasar)*Faktor Kelangkaan
	~	satuan
	~		|

IT Dasar=100
	~	
	~		|

Tahun Awal=2018
	~	
	~		|

Faktor Kelangkaan=(Faktor Kelangkaan Beras+Faktor Kelangkaan Jagung+Faktor kelangkaan Kacang Hijau\
		+Faktor Kelangkaan Kacang Tanah+Faktor Kelangkaan Kedelai+Faktor Kelangkaan Ubi Jalar\
		+Faktor Kelangkaan Ubi Kayu)/7
	~	
	~		|

Tahun Akhir=2024
	~	
	~		|

Laju Pertumbuhan NDVI=(NDVI Akhir / NDVI Awal) ^ (1 / (Tahun Akhir - Tahun Awal)) - 1
	~	
	~		|

NDVI Awal= INITIAL(Data Historis NDVI)
	~	
	~		|

NDVI Akhir=SAMPLE IF TRUE(Time = Tahun Akhir, Data Historis NDVI, 0)
	~	
	~		|

NDVI=IF THEN ELSE(
	    Time <= Tahun Akhir, 
	    Data Historis NDVI, 
	    NDVI Akhir * (1 + Laju Pertumbuhan NDVI) ^ (Time - Tahun Akhir)
	)
	~	satuan
	~		|

Tren Pengeluaran Makro = WITH LOOKUP (Time,
		([(2018,1)-(2024,0.9786)],(2018,1), (2019,0.8509), (2020,0.8687), (2021,0.8864), (2022\
		,0.9161), (2023,0.9486), (2024,0.9786
		)))
	~	
	~		|

Faktor Ekonomi Kedelai=(Harga Produsen Kedelai/Harga Dasar Kedelai)*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Padi=Harga Produsen Padi GKG/Harga Dasar Padi GKG*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Konsumsi Beras Per Kapita = WITH LOOKUP (Time,
		([(2018,100)-(2025,92.5)],(2018,100), (2019,96.7), (2020,97.3), (2021,96.6), (2022,\
		94.7), (2023,94.3), (2024,92.5), (2025
		,92.5)))
	~	kg/tahun
	~		|

Konsumsi Jagung Per Kapita = WITH LOOKUP (Time,
		([(2018,0.4)-(2025,0.6)],(2018,0.4), (2019,0.8), (2020,1.1), (2021,0.4), (2022,0.5)\
		, (2023,0.6), (2024,0.6), (2025,0.6
		)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Kacang Hijau Per Kapita = WITH LOOKUP (Time,
		([(2018,0.6)-(2025,94.3)],(2018,0.6), (2019,0.7), (2020,0.6), (2021,0.5), (2022,0.6\
		), (2023,0.5), (2024,0.5), (2025,0.5
		)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Kacang Tanah Per Kapita = WITH LOOKUP (Time,
		([(2018,0.2)-(2025,0.2)],(2018,0.2), (2019, 0.3), (2020,0.3), (2021,0.3), (2022,0.3\
		), (2023,0.2), (2024,0.2), (2025,0.2
		)))
	~	kg/(kapita/tahun)
	~		|

Konsumsi Kedelai Per Kapita = WITH LOOKUP (Time,
		([(2018,10.5)-(2025,9.8)],(2018,10.5), (2019,10.4), (2020,10.1), (2021,10.7), (2022\
		,11.3), (2023,9.8), (2024,9.8), (2025
		,9.8)))
	~	kg/(kapita*Year)
	~		|

Konsumsi Ubi Jalar Per Kapita = WITH LOOKUP (Time,
		([(2018,8.7)-(2025,94.3)],(2018,8.7), (2019,8.7), (2020,8.8), (2021,10.7), (2022,10\
		), (2023,10.3), (2024,10.3), (2025,
		10.3)))
	~	kg/(kapita*Year)
	~		|

Faktor Ekonomi Jagung=(Harga Produsen Jagung/Harga Dasar Jagung)*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Kacang Hijau=Harga Produsen Kacang Hijau/Harga Dasar Kacang Hijau*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Kacang Tanah=Harga Produsen Kacang Tanah/Harga dasar Kacang Tanah*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Faktor Ekonomi Ubi Kayu=(Harga Produsen Ubi Kayu/Harga Dasar Ubi Kayu)*Faktor Ekonomi Pertanian
	~	satuan
	~		|

Harga Total=(Harga Produsen Jagung+Harga Produsen Kacang Hijau+Harga Produsen Kacang Tanah\
		+Harga Produsen Kedelai+Harga Produsen Padi GKG
	+Harga Produsen Ubi Jalar+Harga Produsen Ubi Kayu)/7
	~	rp
	~		|

Faktor Ekonomi Ubi Jalar=(Harga Produsen Ubi Jalar/ Harga Dasar Ubi Jalar) * Faktor Ekonomi Pertanian
	~	satuan
	~		|

PDRB Pertanian Tanaman Pangan=Nilai Produksi Jagung+Nilai Produksi Kacang Hijau+Nilai Produksi Kacang Tanah\
		+Nilai Produksi Kedelai+Nilai Produksi Padi
	+Nilai Produksi Ubi+Nilai Produksi Ubi Jalar
	~	rp
	~		|

Penambahan Luas Sawah Irigasi=Efektivitas Irigasi*Luas Sawah Irigasi Dasar*Persentase Perubahan Irigasi
	~	ha
	~		|

Konsumsi Ubi Kayu Per Kapita = WITH LOOKUP (Time,
		([(2018,0.3)-(2025,0.7)],(2018,8.7), (2019,8.7), (2020,8.8), (2021,10.7), (2022,10)\
		, (2023,10.3), (2024,10.3), (2025,10.3
		)))
	~	kg/kapita/Year
	~		|

Perubahan Luas Citra=IF THEN ELSE(
	Time = 2018,
	Estimasi Luas Citra - Luas Lahan Pertanian,
	Estimasi Luas Citra - DELAY1(Estimasi Luas Citra,1)
	)
	~	
	~		|

Luas Lahan Pertanian= INTEG (Laju Penambahan Lahan-Alih Fungsi Lahan,
		2.41616e+06)
	~	ha
	~		|

Alih Fungsi Lahan=MAX(0, -Perubahan Luas Citra)
	/ Efektivitas LP2B
	~	
	~		|

Subsidi Pupuk=IF THEN ELSE( Time < 2025 , 
	              Data Historis Subsidi Pupuk(Time) , 
	              Subsidi Dasar * (1 + "% Kenaikan Subsidi" * Efek RAB) )
	~	ton
	~		|

Data Historis Subsidi Pupuk([(0,0)-(10,10)],(2018,497.391), (2019,460.264), (2020,526.235\
		), (2021,488.158), (2022,540.29), (2023,463.131), (2024,388.098))
	~	
	~		|

Laju Penambahan Lahan=MAX(0, Perubahan Luas Citra)
	~	
	~		|

Luas Pixel=6.25
	~	ha
	~		|

"% LP2B"=0
	~	ha
	~		|

Efektivitas LP2B=1 + "% LP2B"
	~	persen
	~		|

Stok Kacang Hijau= INTEG (Penyediaan Kacang Hijau-Penggunaan Kacang Hijau,
		10157.8)
