{UTF-8}
Laju Pertumbuhan Penduduk = WITH LOOKUP (Time,
		 ( (2015,0.0114),(2016,0.0126),(2017,0.0134),(2018,0.0149),(2019,0.0146),(
		2020,0.0189),(2021,0.0185),(2022,0.0192),(2023,0.0182),(2024,0.0175),(2025,0.0175) \
		))
	~	persen/tahun
	~		|

Konsumsi Per Kapita=119.8
	~	kg/tahun
	~		|

Jumlah Penduduk= INTEG ((Pertumbuhan Penduduk),
		46709.6)
	~	jiwa
	~		|

IKP=Produksi Padi/Konsumsi Total
	~	indeks
	~		|

Konsumsi Total=Jumlah Penduduk * Konsumsi Per Kapita
	~	ton/tahun
	~		|

Pertumbuhan Penduduk=Laju Pertumbuhan Penduduk * Jumlah Penduduk
	~	jiwa
	~		|

Laju Alih Fungsi Lahan=min(
	    min(Tingkat Alih Fungsi * (Luas Lahan Vegetasi - LP2B),
	        Luas Lahan Vegetasi - LP2B),
	    2000 * (1 - Nilai Tukar Petani / 100)
	)
	*
	(1 / (IKP / 100))
	~	ha/tahun
	~		|

Luas Lahan Vegetasi= INTEG (-Laju Alih Fungsi Lahan,
		5.07042e+15)
	~	ha
	~		|

LP2B=524425
	~	ha
	~		|

Biaya Produksi=Luas Panen*Biaya Produksi Per Ha
	~	rp
	~		|

"% Irigasi Teknis"=0.4
	~	persen
	~		|

Belanja Pemerintah Sektor Pertanian=5e+11
	~	rp
	~		|

Biaya Produksi Per Ha=1.5e+07 - (1e-05 * Belanja Pemerintah Sektor Pertanian) - (20 *\
		 Subsidi Pupuk)
	~	rp/ha
	~		|

Harga Gabah=5.5e+06
	~	rp/ton
	~		|

Indeks Pertanaman=1 + "% Irigasi Teknis"
	~	kali/tahun
	~		|

Luas Panen=Luas Lahan Vegetasi * Indeks Pertanaman
	~	ha
	~		|

NDVI=0.7 * (Luas Lahan Vegetasi / 1e+06)
	~	satuan
	~		|

Nilai Tukar Petani=Pendapatan Petani/Biaya Produksi*100
	~	satuan
	~		|

Pendapatan Petani=Produksi Padi*Harga Gabah
	~	rp
	~		|

Produksi Padi=Produktivitas Padi * Luas Panen
	~	kg
	~		|

Produktivitas Padi=56.51 * (NDVI / 0.7)
	~	ton/ha
	~		|

Subsidi Pupuk=150000
	~	ton
	~		|

Tingkat Alih Fungsi=0.1
	~	persen
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2025
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2015
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

