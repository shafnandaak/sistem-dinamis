{UTF-8}
Ketersediaan Kalori Ubi Jalar=Ubi Jalar Food*1000*Kalori Ubi Jalar*BDD Ubi Jalar
	~	kkal/hari/kapita
	~		|

Ubi Jalar Food=Jumlah Penduduk*Konsumsi Perkapita Ubi Jalar/Konversi Ton Kilogram
	~	
	~		|

"Jagung Industri Non-Makanan"=Penyediaan Jagung*"K Industri Non-Makanan Jagung"
	~	ton
	~		|

Jagung Benih=Penyediaan Jagung*K Benih Jagung
	~	ton
	~		|

Jagung Industri Makanan=Penyediaan Jagung*K Industri Makanan Jagung
	~	ton
	~		|

Proyeksi Konsumsi Perkapita Ubi Jalar=(3.3 / 2.1) ^ (1 / (Tahun Akhir - Tahun Awal)) \
		- 1
	~	kilogram/kapita/tahun
	~		|

Konsumsi Perkapita Ubi Jalar=IF THEN ELSE(Time < 2025, Data Historis Konsumsi Perkapita Ubi Jalar\
		, Proyeksi Konsumsi Perkapita Ubi Jalar)
	~	kilogram/kapita/tahun
	~		|

Jagung Tercecer=Penyediaan Jagung*K Tercecer Jagung
	~	ton
	~		|

Beras Food=Jumlah Penduduk*Konsumsi Perkapita Beras/Konversi Ton Kilogram
	~	
	~		|

Jagung Pakan=Penyediaan Jagung*K Pakan Jagung
	~	ton
	~		|

Data Historis Konsumsi Perkapita Ubi Jalar = WITH LOOKUP (Time,
		([(2018,2.1)-(2025,3.3)],
		 (2018,2.1),
		 (2019,2.4),
		 (2020,2),
		 (2021,3),
		 (2022,2.7),
		 (2023,2.7),
		 (2024,2),
		 (2025,3.3)))
	~	kilogram/kapita/tahun
	~		|

Proyeksi Konsumsi Perkapita Jagung=0.8 * ( 1 + (0.8 / 0.4) ^ (1 / (Tahun Akhir - Tahun Awal\
		)) - 1 ) ^(Time-Tahun Akhir)
	~	kilogram/kapita/tahun
	~		|

Data Historis Konsumsi Perkapita Beras = WITH LOOKUP (Time,
		([(2018,100)-(2025,86.3)],
		 (2018,100),
		 (2019,96.7),
		 (2020,97.3),
		 (2021,96.6),
		 (2022,94.7),
		 (2023,94.3),
		 (2024,92.5),
		 (2025,86.3)))
	~	kilogram/kapita/tahun
	~		|

Konsumsi Perkapita Beras=IF THEN ELSE(Time < 2025, Data Historis Konsumsi Perkapita Beras\
		, Proyeksi Konsumsi Perkapita Beras)
	~	kilogram/kapita/tahun
	~		|

Penggunaan Beras=Beras Benih+Beras Industri Makanan+"Beras Industri Non-Makanan"+Beras Pakan\
		+Beras Tercecer + Beras Food
