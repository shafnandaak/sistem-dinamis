{UTF-8}
Data Historis Konsumsi Perkapita Kacang Hijau 0 = WITH LOOKUP (Time,
		([(2018,0.6)-(2025,0.5)],
		 (2018,0.6),
		 (2019,0.7),
		 (2020,0.6),
		 (2021,0.5),
		 (2022,0.6),
		 (2023,0.5),
		 (2024,0.5),
		 (2025,0.5)))
	~	kilogram/kapita/tahun
	~		|

Konsumsi Perkapita Kacang Hijau 0=IF THEN ELSE(Time < 2025, Data Historis Konsumsi Perkapita Kacang Hijau 0\
		, Proyeksi Konsumsi Perkapita Kacang Hijau 0)
	~	kilogram/kapita/tahun
	~		|

Penggunaan Beras  = A FUNCTION OF( Beras Benih,Beras Food,Beras Industri Makanan,"Beras Industri Non-Makanan"\
		,Beras Pakan,Beras Tercecer) ~~|
Penggunaan Beras=Beras Benih+Beras Industri Makanan+"Beras Industri Non-Makanan"+Beras Pakan\
		+Beras Tercecer
	~	
	~		|

Beras Food  = A FUNCTION OF( Jumlah Penduduk,Konsumsi Perkapita Kacang Hijau 0) ~~|
Beras Food=Stok Beras-Beras Benih-Beras Industri Makanan-"Beras Industri Non-Makanan"\
		-Beras Pakan-Beras Tercecer
	~	
	~		|

Proyeksi Konsumsi Perkapita Kacang Hijau 0=(0.5 / 0.6) ^ (1 / (Tahun Akhir - Tahun Awal\
		)) - 1
	~	kilogram/kapita/tahun
	~		|

Ketersediaan Kalori Beras  = A FUNCTION OF( BDD Beras,Beras Food,Kalori Beras) ~~|
Ketersediaan Kalori Beras=Ketersediaan Perkapita Beras*Kalori Beras*BDD Beras
	~	
	~		|

Proyeksi Konsumsi Perkapita Kedelai=(10.5 / 10.5) ^ (1 / (Tahun Akhir - Tahun Awal)) \
		- 1
	~	kilogram/kapita/tahun
	~		|

Proyeksi Konsumsi Perkapita Ubi Kayu=(12.1 / 8.7) ^ (1 / (Tahun Akhir - Tahun Awal)) \
		- 1
	~	kilogram/kapita/tahun
	~		|

