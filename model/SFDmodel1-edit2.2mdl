{UTF-8}
Belanja Pemerintah Sektor Pertanian=2e+12 + Penambahan RAB
	~	rp
	~		|

Biaya Produksi=Luas Panen*Biaya Produksi Per Ha
	~	rp
	~		|

Biaya Produksi Per Ha=1.5e+07
	*
	(1 - Sensitivitas RAB * Efek RAB)
	*
	(1 - Sensitivitas Subsidi Pupuk * Efek Subsidi Pupuk)
	~	rp/ha
	~		|

Efek RAB=Belanja Pemerintah Sektor Pertanian / 2e+12
	~	konst
	~		|

Efek Subsidi Pupuk=Subsidi Pupuk / 5e+12
	~	konst
	~		|

Sensitivitas RAB=0.1
	~	konst
	~		|

Penambahan RAB=0
	~	rp
	~		|

Subsidi Pupuk=5e+12
	~	ton
	~		|

Sensitivitas Subsidi Pupuk=0.2
	~	konst
	~		|

Luas Lahan Vegetasi= INTEG (Penambahan - Laju Alih Fungsi Lahan,
		3.59473e+06)
	~	ha
	~		|

Luas Panen=Luas Lahan Vegetasi * 0.47
	~	ha
	~		|

NDVI = WITH LOOKUP (Time,
		([(2015,0.3)-(2025,0.7)],(2015,0.62215), (2016,0.6274), (2017,0.62925), (2018,0.63397\
		), (2019,0.53013), (2020,0.58145), (2021,0.60513), (2022,0.39735), (2023,0.35376), \
		(2024,0.36544), (2025,0.38799)))
	~	satuan
	~		|

Laju Alih Fungsi Lahan=0.0002
	*
	max(0, Luas Lahan Vegetasi - LP2B)
	*
	(1 + (100 - Nilai Tukar Petani)/100)
	*
	(1 + (100 - IKP)/100)
	~	ha/tahun
	~		|

Penambahan=0.0002 * Luas Lahan Vegetasi
	~	ha
	~		|

Penambahan LP2B=0
	~	ha
	~		|

LP2B=524425 + Penambahan LP2B
	~	ha
	~		|

Laju Pertumbuhan Penduduk = WITH LOOKUP (Time,
		 ( (2015,0.0114),(2016,0.0126),(2017,0.0134),(2018,0.0149),(2019,0.0146),(
		2020,0.0189),(2021,0.0185),(2022,0.0192),(2023,0.0182),(2024,0.0175),(2025,0.0175) \
		))
	~	persen/tahun
	~		|

Konsumsi Per Kapita=119.8
	~	kg/tahun
	~		|

Jumlah Penduduk= INTEG ((Pertumbuhan Penduduk),
		46709.6)
	~	jiwa
	~		|

IKP=Produksi Padi/Konsumsi Total*100
	~	indeks
	~		|

Konsumsi Total=Jumlah Penduduk * Konsumsi Per Kapita
	~	ton/tahun
	~		|

Pertumbuhan Penduduk=Laju Pertumbuhan Penduduk * Jumlah Penduduk
	~	jiwa
	~		|

Harga Gabah=5500
	~	rp/kg
	~		|

Nilai Tukar Petani=Pendapatan Petani/Biaya Produksi*100
	~	satuan
	~		|

Pendapatan Petani=Produksi Padi*1000*Harga Gabah
	~	rp
	~		|

Produksi Padi=Produktivitas Padi * Luas Panen
	~	kg
	~		|

Produktivitas Padi=5.5 + 0.8 * (NDVI - 0.6)
	~	ton/ha
	~		|

********************************************************
	.Control
********************************************************~
		Simulation Control Parameters
	|

FINAL TIME  = 2025
	~	Year
	~	The final time for the simulation.
	|

INITIAL TIME  = 2015
	~	Year
	~	The initial time for the simulation.
	|

SAVEPER  = 
        TIME STEP
	~	Year [0,?]
	~	The frequency with which output is stored.
	|

TIME STEP  = 1
	~	Year [0,?]
	~	The time step for the simulation.
	|

